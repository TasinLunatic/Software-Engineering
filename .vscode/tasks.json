{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build leaderboard",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "src/leaderboard.cpp",
        "-o",
        "leaderboard.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run leaderboard tests",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "tests/test_leaderboard.cpp",
        "-o",
        "tests/test_leaderboard.exe"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}